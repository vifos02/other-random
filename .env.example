# Credenciais Prenotami
PRENOTAMI_EMAIL=seu@email.com
PRENOTAMI_PASSWORD=sua_senha

# ID do serviço desejado (veja lista abaixo ou deixe em branco para detectar automaticamente)
# Exemplos comuns: cidadania italiana = verificar na URL após selecionar o serviço
PRENOTAMI_SERVICE_ID=

# Intervalo entre tentativas (segundos) - recomendado: 60-180
CHECK_INTERVAL=90

# Notificação por email (opcional) - envia email quando agendar
NOTIFY_EMAIL=seu@email.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASSWORD=sua_senha_app_gmail

# Modo de depuração: true = mostra o navegador, false = invisível
HEADLESS=true
