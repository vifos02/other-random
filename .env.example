# ─── Credenciais Prenotami ────────────────────────────────────────────────────
PRENOTAMI_EMAIL=seu@email.com
PRENOTAMI_PASSWORD=sua_senha_aqui

# ─── Serviço ──────────────────────────────────────────────────────────────────
# Deixe em branco: o bot busca "Benefício de Lei para Menores" automaticamente.
# Preencha com o número da URL se souber (ex: .../Services/1234 → 1234)
PRENOTAMI_SERVICE_ID=

# ─── Intervalo de verificação ─────────────────────────────────────────────────
# Segundos entre cada tentativa. Mínimo recomendado: 60
CHECK_INTERVAL=90

# ─── CAPTCHA / bloqueio ───────────────────────────────────────────────────────
# Minutos que o bot aguarda quando detecta CAPTCHA ou bloqueio antes de tentar novamente
# (em modo headless, aguarda este tempo e recomeça automaticamente)
CAPTCHA_WAIT_MINUTES=20

# ─── Modo de execução ─────────────────────────────────────────────────────────
# true = navegador invisível (recomendado para rodar em background)
# false = mostrar o navegador (útil para ver o que está acontecendo)
HEADLESS=true

# ─── Notificação por email (opcional) ────────────────────────────────────────
# Deixe em branco para desativar. Ao agendar, envia email de confirmação.
NOTIFY_EMAIL=seu@email.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
# Para Gmail: use "Senha de app" em Conta Google → Segurança → Senhas de app
SMTP_PASSWORD=senha_app_gmail
